            font-size: 12px;
            font-weight: 500;
            margin-left: 15px;
            transition: all 0.3s;
        }

        /* ===== SIDEBAR COMPACT & RAPI ===== */
        /* Kurangi padding sidebar */
        .main-sidebar {
            padding-top: 0;
        }

        /* Brand link lebih compact */
        .brand-link {
            padding: 12px 15px !important;
            height: auto !important;
        }

        /* User panel lebih compact */
        .user-panel {
            padding: 12px 15px !important;
